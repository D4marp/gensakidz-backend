# Copy this file to .env and adjust the values, then run:
#   docker compose up -d --build
# (docker compose reads .env automatically from this folder)

# Port exposed on the HOST machine (container always listens on 8080 internally)
HOST_PORT=8097

# Admin login — only used the very first time the app starts (empty admin_users table).
# Change these before your first deploy.
ADMIN_EMAIL=admin@gensakidz.com
ADMIN_PASSWORD=change-this-password

# --- MySQL ---
# These same values are used both to configure the mysql container itself
# (docker-compose.yml) and for the backend to connect to it — keep them in sync.
DB_NAME=gensakidz
DB_USER=gensakidz
DB_PASSWORD=change-this-too

# Usually no need to touch these when running via docker-compose (the backend
# talks to the "mysql" service by its container name on port 3306 already).
# Only relevant if you run the binary directly with `go run .` against an
# external/self-managed MySQL server.
PORT=8080
DB_HOST=127.0.0.1
DB_PORT=3306

# Must match the volume mount target in docker-compose.yml
# (gensakidz_uploads:/app/data/uploads) — a relative path here writes
# uploaded photos outside the persistent volume and they'll vanish on
# every redeploy.
UPLOADS_DIR=/app/data/uploads
